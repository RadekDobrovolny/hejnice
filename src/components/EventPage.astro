---
import "../styles/global.css";

const { event } = Astro.props;
const { Content } = await event.render();
const contact = event.data.contact;
const phoneHref = contact?.phone ? `tel:${contact.phone.replace(/\s/g, "")}` : undefined;
const baseUrl = import.meta.env.BASE_URL.endsWith("/")
  ? import.meta.env.BASE_URL
  : `${import.meta.env.BASE_URL}/`;
const canonicalUrl = new URL(`/${event.slug}/`, Astro.site);
---

<html lang="cs">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <base href={baseUrl} />
    <link rel="icon" type="image/png" sizes="64x64" href={`${baseUrl}favicon.png`} />
    <link rel="shortcut icon" href={`${baseUrl}favicon.ico`} />
    <link rel="canonical" href={canonicalUrl} />
    <title>{event.data.title}</title>
  </head>

  <body class={`theme-${event.data.theme}`}>
    <h1>{event.data.title}</h1>
    <section class="event-details" aria-label="Základní informace o události">
      <div class="event-detail">
        <img class="event-detail__icon" src={`${baseUrl}icons/kalendar.png`} alt="" />
        <div>
          <h2 class="event-detail__title">Kdy</h2>
          <p>{event.data.date}<br />{event.data.time}</p>
        </div>
      </div>

      <div class="event-detail">
        <img class="event-detail__icon" src={`${baseUrl}icons/mapa.png`} alt="" />
        <div>
          <h2 class="event-detail__title">Kde</h2>
          <p>
            {event.data.locationUrl ? (
              <a href={event.data.locationUrl} target="_blank" rel="noreferrer">{event.data.location}</a>
            ) : (
              event.data.location
            )}
          </p>
        </div>
      </div>

      {event.data.accommodation && (
        <div class="event-detail">
          <img class="event-detail__icon" src={`${baseUrl}icons/stan.png`} alt="" />
          <div>
            <h2 class="event-detail__title">Spaní</h2>
            <p>{event.data.accommodation.map((line) => <span>{line}</span>)}</p>
          </div>
        </div>
      )}
    </section>
    <Content />

    <div>
      <h2>Účastníci</h2>
      <div id="participants" class="participants-grid"></div>
    </div>

    <div class="card">
      <h2>Přihlášení</h2>
      <form id="signup-form" data-event-slug={event.slug}>
        <input id="name" name="name" placeholder="Tvoje jméno" minlength="2" maxlength="60" required />
        <button type="submit">Přihlásit</button>
      </form>
      <p id="msg" class="error" aria-live="polite"></p>
      <p class="note">Rozmyslel*a sis to? Napiš Radkovi, odebere tě</p>
    </div>

    {contact && (
      <div class="contact">
        <h2>Kontakt</h2>
        <ul class="contact-list">
          <li>
            <a href={`mailto:${contact.email}`}>
              <span class="emoji">📧</span>
              {contact.email}
            </a>
          </li>
          <li>
            <a href={phoneHref}>
              <span class="emoji">📱</span>
              {contact.phone}
            </a>
          </li>
        </ul>
      </div>
    )}

    <script>
      import "../scripts/signup.js";
    </script>
  </body>
</html>
